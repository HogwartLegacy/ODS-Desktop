<Project>
  <!--
    Shared settings for the native Windows desktop app.
    OdsVersion must match ODS_VERSION in upstream/installers/windows/lib/constants.ps1;
    Ods.Core.Tests checks it. The desktop build adds its own prerelease suffix.
  -->
  <PropertyGroup>
    <OdsVersion>3.0.0</OdsVersion>
    <DesktopPrerelease>preview.1</DesktopPrerelease>
    <Version>$(OdsVersion)-$(DesktopPrerelease)</Version>
    <Company>Osmantic</Company>
    <Product>ODS</Product>
    <Copyright>Copyright (c) Osmantic and ODS contributors. Apache-2.0.</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Files vendored from Osmantic/ODS (see upstream/README.md); the app reads them as its source of truth. -->
    <OdsRoot>$(MSBuildThisFileDirectory)upstream\</OdsRoot>
    <DesktopRoot>$(MSBuildThisFileDirectory)</DesktopRoot>
  </PropertyGroup>
</Project>
