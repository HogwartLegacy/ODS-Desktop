<UserControl x:Class="Ods.Desktop.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- One setup step: an icon for its state, the title, detail and progress. -->
        <DataTemplate x:Key="StepTemplate">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Top" Margin="0,1,0,0">
                    <ui:SymbolIcon Symbol="Circle24" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding State, Converter={StaticResource WhenEquals}, ConverterParameter=pending}" />
                    <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True"
                                     Visibility="{Binding State, Converter={StaticResource WhenEquals}, ConverterParameter=running}" />
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Filled="True" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                   Visibility="{Binding State, Converter={StaticResource WhenEquals}, ConverterParameter=done}" />
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="20" Filled="True" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding State, Converter={StaticResource WhenEquals}, ConverterParameter=failed}" />
                </Grid>
                <StackPanel Grid.Column="1">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Title}" />
                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" Margin="0,2,0,0"
                                  Visibility="{Binding Detail, Converter={StaticResource VisibleIfSet}}" />
                    <ProgressBar Margin="0,6,0,0" Height="4" Maximum="100" Value="{Binding Progress}"
                                 Visibility="{Binding HasProgress, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="820" Margin="32,24,32,32" HorizontalAlignment="Center">

            <!-- 0: Welcome -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource WhenEquals}, ConverterParameter=0}" Margin="0,24,0,0">
                <Image Source="pack://application:,,,/Assets/ods-icon-192.png" Width="96" Height="96" HorizontalAlignment="Left" />
                <ui:TextBlock FontTypography="TitleLarge" Text="Welcome to ODS" Margin="0,20,0,6" />
                <ui:TextBlock Style="{StaticResource PageSubtitle}" FontSize="16"
                              Text="Private AI that runs on this PC. No Docker, no WSL, no cloud account." />

                <ui:Card Margin="0,8,0,0" Padding="20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="22" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="A model picked for your hardware" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="ODS checks your GPU and memory and chooses with the same policy as its Linux and macOS installers." />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="Chat24" FontSize="22" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="Chat here, or use it from your apps" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="An OpenAI-compatible API on localhost, protected by a key only you have." />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="Your data stays on this PC" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="ODS downloads llama.cpp from GitHub and models from Hugging Face, each checked against a pinned SHA-256, and checks for ODS updates. It sends no telemetry." />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Button Margin="0,24,0,0" Appearance="Primary" Padding="24,8" Content="Get started" Command="{Binding BeginCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowRight24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <!-- 1: Checking this PC -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource WhenEquals}, ConverterParameter=1}" Margin="0,80,0,0" HorizontalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                <ui:TextBlock FontTypography="Subtitle" Text="Checking this PC…" Margin="0,20,0,0" HorizontalAlignment="Center" />
                <ui:TextBlock Style="{StaticResource Caption}" Text="Graphics, memory and processor" HorizontalAlignment="Center" />
                <ui:InfoBar Margin="0,20,0,0" Severity="Error" IsOpen="{Binding Error, Converter={StaticResource HasValue}}" IsClosable="False"
                            Title="ODS cannot run here yet" Message="{Binding Error}" />
            </StackPanel>

            <!-- 2: Choose a model -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource WhenEquals}, ConverterParameter=2}">
                <ui:TextBlock Style="{StaticResource PageTitle}" Text="Your PC and your model" />
                <ui:TextBlock Style="{StaticResource PageSubtitle}" Text="ODS picked a model that fits this PC. You can change models any time on the Models page." />

                <ui:Card Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource FactLabel}" Text="Processor" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding CpuText}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource FactLabel}" Text="Memory" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding MemoryText}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource FactLabel}" Text="Graphics" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding GpuText}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource FactLabel}" Text="Runs with" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}" FontWeight="SemiBold" Text="{Binding AccelerationText}" />
                    </Grid>
                </ui:Card>

                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:InfoBar Margin="0,4,0,0" Severity="Informational" IsOpen="True" IsClosable="False" Message="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Model" />
                <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CardListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding Recommended, Converter={StaticResource Visible}}">
                                        <TextBlock Text="Recommended" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Facts}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Storage" />
                <ui:CardControl Header="Models folder" Margin="0,0,0,6">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Folder24" />
                    </ui:CardControl.Icon>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ModelsDirectory}" TextTrimming="CharacterEllipsis" MaxWidth="380" HorizontalAlignment="Right" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding FreeSpaceText}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <ui:Button Content="Change…" Command="{Binding ChooseFolderCommand}" />
                    </StackPanel>
                </ui:CardControl>

                <CheckBox Margin="0,12,0,0" IsChecked="{Binding UseBootstrap}"
                          Visibility="{Binding BootstrapAvailable, Converter={StaticResource Visible}}"
                          Content="Start chatting right away with a small model while the recommended one downloads" />
                <CheckBox Margin="0,8,0,0" IsChecked="{Binding StartWithWindows}" Content="Start ODS when I sign in to Windows" />

                <ui:TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" Text="{Binding DownloadSummary}" />

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <ui:Button Appearance="Primary" Padding="24,8" Content="Install" Command="{Binding InstallCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </StackPanel>

            <!-- 3: Installing -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource WhenEquals}, ConverterParameter=3}">
                <ui:TextBlock Style="{StaticResource PageTitle}" Text="Setting up ODS" />
                <ui:TextBlock Style="{StaticResource PageSubtitle}" Text="Downloads resume automatically if the connection drops. You can keep using your PC." />
                <ui:Card Padding="20">
                    <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}" />
                </ui:Card>
                <ui:InfoBar Margin="0,16,0,0" Severity="Error" IsClosable="False" Title="Setup did not finish"
                            IsOpen="{Binding Error, Converter={StaticResource HasValue}}" Message="{Binding Error}" />
                <ui:Button Margin="0,12,0,0" Appearance="Primary" Content="Try again" Command="{Binding InstallCommand}"
                           Visibility="{Binding Error, Converter={StaticResource VisibleIfSet}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <!-- 4: Ready -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource WhenEquals}, ConverterParameter=4}" Margin="0,48,0,0">
                <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" FontSize="64" HorizontalAlignment="Left" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                <ui:TextBlock FontTypography="TitleLarge" Text="ODS is ready" Margin="0,16,0,6" />
                <ui:TextBlock Style="{StaticResource PageSubtitle}" FontSize="15" Text="{Binding ReadyDetail}" />
                <ui:Card Padding="16">
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="Test question" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ProofText}" />
                    </StackPanel>
                </ui:Card>
                <ui:Button Margin="0,24,0,0" Appearance="Primary" Padding="24,8" Content="Start chatting" Command="{Binding FinishCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Chat24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
