<ui:FluentWindow x:Class="Ods.Desktop.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 xmlns:pages="clr-namespace:Ods.Desktop.Views.Pages"
                 xmlns:views="clr-namespace:Ods.Desktop.Views"
                 Title="ODS"
                 Width="1240"
                 Height="820"
                 MinWidth="980"
                 MinHeight="660"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/ods.ico">

    <Window.Resources>
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shell.StatusKind}" Value="ready">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Shell.StatusKind}" Value="busy">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Shell.StatusKind}" Value="failed">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="ODS" CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/ods-icon-192.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True"
                                     Visibility="{Binding Shell.IsBusy, Converter={StaticResource Visible}}" />
                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding Shell.BusyText}" />
                    <Border Style="{StaticResource StatusPill}" ToolTip="{Binding Shell.StatusTitle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="12" Text="{Binding Shell.PillText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Navigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           Visibility="{Binding Shell.IsOnboarding, Converter={StaticResource Collapsed}}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home" TargetPageType="{x:Type pages:HomePage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Chat" TargetPageType="{x:Type pages:ChatPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Chat24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Models" TargetPageType="{x:Type pages:ModelsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Cube24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Extensions" TargetPageType="{x:Type pages:ExtensionsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Logs" TargetPageType="{x:Type pages:LogsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DocumentText24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="Snackbars" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <views:OnboardingView Grid.Row="1"
                              DataContext="{Binding Onboarding}"
                              Visibility="{Binding DataContext.Shell.IsOnboarding, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />

        <tray:NotifyIcon x:Name="Tray"
                         Grid.Row="0"
                         FocusOnLeftClick="True"
                         MenuOnRightClick="True"
                         TooltipText="ODS"
                         Icon="pack://application:,,,/Assets/ods-icon-192.png"
                         LeftDoubleClick="OnTrayOpen">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Open ODS" Click="OnTrayOpen" FontWeight="SemiBold" />
                    <MenuItem Header="Chat" Click="OnTrayChat" />
                    <Separator />
                    <MenuItem Header="Start model server" Command="{Binding Shell.StartCommand}" />
                    <MenuItem Header="Stop model server" Command="{Binding Shell.StopCommand}" />
                    <Separator />
                    <MenuItem Header="Quit ODS" Click="OnTrayQuit" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
