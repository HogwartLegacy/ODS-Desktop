<Page x:Class="Ods.Desktop.Views.Pages.ExtensionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Extensions"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="StatusBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="ready">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="next">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="attention">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="ready">
                    <Setter Property="Foreground" Value="Black" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="next">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="attention">
                    <Setter Property="Foreground" Value="Black" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1100">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="Extensions" />
            <ui:TextBlock Style="{StaticResource PageSubtitle}"
                          Text="The ODS service stack and how each part runs natively on Windows, without Docker or WSL." />

            <ui:InfoBar Severity="Informational" IsOpen="True" IsClosable="False" Title="Native Windows, step by step"
                        Message="Local inference, model management and this control center are native today. Each other service gets a pinned, verified Windows build or an embedded runtime, following the migration plan." />
            <ui:Button Margin="0,8,0,0" Content="Read the migration plan" Command="{Binding OpenPlanCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Open24" />
                </ui:Button.Icon>
            </ui:Button>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Core services" />
            <ItemsControl ItemsSource="{Binding Core}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8" Padding="18,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" Margin="0,0,10,0" />
                                    <Border Style="{StaticResource StatusBadge}">
                                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding StatusText}" />
                                    </Border>
                                </StackPanel>
                                <ui:TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding Description}"
                                              Visibility="{Binding Description, Converter={StaticResource VisibleIfSet}}" />
                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Approach}" />
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,24,0,8">
                <ui:TextBox DockPanel.Dock="Right" Width="280" PlaceholderText="Search the library" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="BodyStrong">
                        <Run Text="Extension library" />
                        <Run Text="(" /><Run Text="{Binding LibraryCount, Mode=OneWay}" /><Run Text=" apps)" />
                    </ui:TextBlock>
                    <ui:TextBlock Style="{StaticResource Caption}" Text="Container apps on Linux and macOS today; each needs a native Windows recipe." />
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Library}" VirtualizingPanel.IsVirtualizing="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
