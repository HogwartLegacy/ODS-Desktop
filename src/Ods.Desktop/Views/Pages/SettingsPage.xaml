<Page x:Class="Ods.Desktop.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Settings"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1000">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <ui:TextBlock Style="{StaticResource PageSubtitle}" Text="ODS runs per user and never needs administrator rights." />

            <ui:TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="General" />
            <ui:CardControl Header="Theme" Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Color24" />
                </ui:CardControl.Icon>
                <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Theme}" MinWidth="200" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Start ODS when I sign in" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StartupNote}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Power24" />
                </ui:CardControl.Icon>
                <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Keep running in the notification area when I close the window" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="Your model and local API stay available. Quit from the tray icon." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Pin24" />
                </ui:CardControl.Icon>
                <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Model server" />
            <ui:CardControl Header="Load the model when ODS starts" Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                </ui:CardControl.Icon>
                <ui:ToggleSwitch IsChecked="{Binding LoadOnStartup}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Port" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="Automatic uses 8080, or 18080 and 28080 when it is taken. The server listens on this PC only." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Globe24" />
                </ui:CardControl.Icon>
                <ui:TextBox Text="{Binding Port, UpdateSourceTrigger=LostFocus}" MinWidth="200" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Reasoning" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="Off answers directly (ODS default). On lets thinking models reason first; slower, sometimes better." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="BrainCircuit24" />
                </ui:CardControl.Icon>
                <ComboBox ItemsSource="{Binding ReasoningModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Reasoning}" MinWidth="200" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="GPU layers" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="All puts the whole model on the GPU, as ODS plans it. Auto lets llama.cpp decide." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="DeveloperBoard24" />
                </ui:CardControl.Icon>
                <ComboBox ItemsSource="{Binding GpuLayerModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GpuLayers}" MinWidth="200" />
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Runtime and storage" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="llama.cpp" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding RuntimeText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Wrench24" />
                </ui:CardControl.Icon>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Check hardware again" Margin="0,0,8,0" Command="{Binding RecheckHardwareCommand}" />
                    <ui:Button Content="Repair" Command="{Binding RepairRuntimeCommand}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Data folder" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding DataFolder}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding StorageText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Storage24" />
                </ui:CardControl.Icon>
                <ui:Button Content="Open" Command="{Binding OpenDataFolderCommand}" />
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Updates" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock>
                            <Run Text="ODS" />
                            <Run Text="{Binding Version, Mode=OneWay}" />
                        </TextBlock>
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Updates.Status}" />
                        <ProgressBar Height="3" Margin="0,6,0,0" Maximum="100" Value="{Binding Updates.DownloadPercent}"
                                     Visibility="{Binding Updates.IsChecking, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                </ui:CardControl.Icon>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Check now" Margin="0,0,8,0" Command="{Binding CheckUpdatesCommand}" />
                    <ui:Button Content="Restart to update" Appearance="Primary" Command="{Binding RestartToUpdateCommand}"
                               Visibility="{Binding Updates.ReadyToRestart, Converter={StaticResource Visible}}" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Header="Check for updates automatically" Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Clock24" />
                </ui:CardControl.Icon>
                <ui:ToggleSwitch IsChecked="{Binding AutoUpdate}" />
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="About" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="ODS by Osmantic" />
                        <ui:TextBlock Style="{StaticResource Caption}"
                                      Text="ODS is Apache-2.0. llama.cpp is MIT. Each model keeps its own license, shown on its model card. ODS collects no telemetry." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Info24" />
                </ui:CardControl.Icon>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="GitHub" Margin="0,0,8,0" Command="{Binding OpenProjectCommand}" />
                    <ui:Button Content="Discord" Command="{Binding OpenDiscordCommand}" />
                </StackPanel>
            </ui:CardControl>

            <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Remove" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Remove all ODS data" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="Deletes downloaded models, chats, logs and settings. ODS stays installed and runs setup again." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </ui:CardControl.Icon>
                <ui:Button Content="Remove data…" Appearance="Danger" Command="{Binding RemoveDataCommand}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Uninstall ODS" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="Same as Settings > Apps in Windows; here you can also choose to remove your data." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Dismiss24" />
                </ui:CardControl.Icon>
                <ui:Button Content="Uninstall…" Command="{Binding UninstallCommand}" />
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
