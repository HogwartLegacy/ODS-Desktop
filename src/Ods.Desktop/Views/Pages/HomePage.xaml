<Page x:Class="Ods.Desktop.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Home"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style x:Key="HeroDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shell.StatusKind}" Value="ready">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Shell.StatusKind}" Value="busy">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Shell.StatusKind}" Value="failed">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1100">
            <ui:TextBlock Style="{StaticResource PageTitle}" Text="Home" />
            <ui:TextBlock Style="{StaticResource PageSubtitle}" Text="Private AI on this PC: the model server, the local API and this PC's resources." />

            <!-- Status -->
            <Border CornerRadius="8" Padding="24" Background="{StaticResource OdsHeroBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource HeroDot}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:TextBlock FontTypography="Subtitle" Text="{Binding Shell.StatusTitle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Margin="24,6,0,0" Text="{Binding Shell.StatusDetail}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ui:Button Appearance="Primary" Content="Start" Margin="0,0,8,0" Command="{Binding Shell.StartCommand}"
                                   Visibility="{Binding Shell.IsActive, Converter={StaticResource Collapsed}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Play24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Open chat" Margin="0,0,8,0" Appearance="Primary" Command="{Binding Shell.OpenChatCommand}"
                                   Visibility="{Binding Shell.IsReady, Converter={StaticResource Visible}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Chat24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Restart" Margin="0,0,8,0" Command="{Binding Shell.RestartCommand}"
                                   Visibility="{Binding Shell.IsActive, Converter={StaticResource Visible}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Stop" Command="{Binding Shell.StopCommand}"
                                   Visibility="{Binding Shell.IsActive, Converter={StaticResource Visible}}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Stop24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Failure and recovery -->
            <StackPanel Visibility="{Binding Shell.Failure, Converter={StaticResource VisibleIfSet}}" Margin="0,12,0,0">
                <ui:InfoBar Severity="Error" IsClosable="False" IsOpen="True"
                            Title="{Binding Shell.Failure.Title}" Message="{Binding Shell.Failure.Detail}" />
                <WrapPanel Margin="0,8,0,0">
                    <ui:Button Content="Restart" Margin="0,0,8,8" Command="{Binding Shell.RestartCommand}"
                               Visibility="{Binding Shell.Failure.Actions, Converter={StaticResource WhenAction}, ConverterParameter=Restart}" />
                    <ui:Button Content="Use a smaller context" Margin="0,0,8,8" Appearance="Primary" Command="{Binding Shell.ReduceContextCommand}"
                               Visibility="{Binding Shell.Failure.Actions, Converter={StaticResource WhenAction}, ConverterParameter=ReduceContext}" />
                    <ui:Button Content="Choose another model" Margin="0,0,8,8" Command="{Binding Shell.ChooseModelCommand}"
                               Visibility="{Binding Shell.Failure.Actions, Converter={StaticResource WhenAction}, ConverterParameter=ChooseModel}" />
                    <ui:Button Content="Repair llama.cpp" Margin="0,0,8,8" Appearance="Primary" Command="{Binding Shell.RepairRuntimeCommand}"
                               Visibility="{Binding Shell.Failure.Actions, Converter={StaticResource WhenAction}, ConverterParameter=RepairRuntime}" />
                    <ui:Button Content="Use a free port" Margin="0,0,8,8" Appearance="Primary" Command="{Binding Shell.ChangePortCommand}"
                               Visibility="{Binding Shell.Failure.Actions, Converter={StaticResource WhenAction}, ConverterParameter=ChangePort}" />
                    <ui:Button Content="Get the latest graphics driver" Margin="0,0,8,8" Command="{Binding Shell.UpdateDriverCommand}"
                               Visibility="{Binding Shell.Failure.Actions, Converter={StaticResource WhenAction}, ConverterParameter=UpdateDriver}" />
                    <ui:Button Content="Open logs" Margin="0,0,8,8" Command="{Binding Shell.OpenLogsCommand}"
                               Visibility="{Binding Shell.Failure.Actions, Converter={StaticResource WhenAction}, ConverterParameter=OpenLogs}" />
                    <ui:Button Content="Dismiss" Margin="0,0,8,8" Appearance="Transparent" Command="{Binding Shell.DismissFailureCommand}" />
                </WrapPanel>
            </StackPanel>

            <!-- Bootstrap download -->
            <ui:Card Margin="0,12,0,0" Padding="20" Visibility="{Binding Shell.HasPendingDownload, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong">
                            <Run Text="Downloading your full model:" />
                            <Run Text="{Binding Shell.PendingModelName, Mode=OneWay}" />
                        </ui:TextBlock>
                        <ProgressBar Margin="0,8,0,6" Height="4" Maximum="1" Value="{Binding Shell.PendingFraction}" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Shell.PendingText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ui:Button Content="Pause" Command="{Binding Shell.PausePendingCommand}"
                                   Visibility="{Binding Shell.PendingPaused, Converter={StaticResource Collapsed}}" />
                        <ui:Button Content="Resume" Appearance="Primary" Command="{Binding Shell.ResumePendingCommand}"
                                   Visibility="{Binding Shell.PendingPaused, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <UniformGrid Columns="2" Margin="-6,12,-6,0">
                <!-- This PC -->
                <ui:Card Margin="6" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,10,0" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="This PC" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FactLabel}" Text="Processor" />
                            <TextBlock Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Cpu}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource FactLabel}" Text="Memory" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Memory}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource FactLabel}" Text="Graphics" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Gpu}" />
                            <TextBlock Grid.Row="3" Style="{StaticResource FactLabel}" Text="Inference" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValue}" Text="{Binding Acceleration}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding}" Margin="0,4,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- Local API -->
                <ui:Card Margin="6" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="PlugConnected24" Margin="0,0,10,0" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="Local API" />
                        </StackPanel>
                        <ui:TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                      Text="OpenAI-compatible and bound to this PC only. Use it from any app that lets you set a base URL and an API key." />
                        <TextBlock Style="{StaticResource FactLabel}" Text="Base URL" />
                        <DockPanel Margin="0,2,0,10">
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" ToolTip="Copy" AutomationProperties.Name="Copy base URL" Command="{Binding CopyEndpointCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Style="{StaticResource Mono}" VerticalAlignment="Center"
                                       Text="{Binding Shell.Endpoint, FallbackValue='Available when the model server is running', TargetNullValue='Available when the model server is running'}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FactLabel}" Text="API key" />
                        <DockPanel Margin="0,2,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton ToolTip="Show or hide" AutomationProperties.Name="Show API key" IsChecked="{Binding ShowKey}" Background="Transparent" BorderThickness="0" Padding="8,4">
                                    <ui:SymbolIcon Symbol="Eye24" />
                                </ToggleButton>
                                <ui:Button Appearance="Transparent" ToolTip="Copy" AutomationProperties.Name="Copy API key" Command="{Binding CopyKeyCommand}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Copy24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Mono}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding ApiKeyDisplay}" />
                        </DockPanel>
                        <ui:Button Content="Copy a sample request" Command="{Binding CopyCurlCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Code24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </ui:Card>

                <!-- Live -->
                <ui:Card Margin="6" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Gauge24" Margin="0,0,10,0" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="Model server" />
                        </StackPanel>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,0,12">
                                <ui:TextBlock Style="{StaticResource Caption}" Text="CPU" />
                                <ui:TextBlock FontTypography="Subtitle" Text="{Binding ProcessCpu}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <ui:TextBlock Style="{StaticResource Caption}" Text="Memory" />
                                <ui:TextBlock FontTypography="Subtitle" Text="{Binding ProcessMemory}" />
                            </StackPanel>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource Caption}" Text="Last reply" />
                                <ui:TextBlock FontTypography="Subtitle" Text="{Binding LastSpeed}" />
                            </StackPanel>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource Caption}" Text="Running for" />
                                <ui:TextBlock FontTypography="Subtitle" Text="{Binding Uptime}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ui:Card>

                <!-- Storage -->
                <ui:Card Margin="6" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Storage24" Margin="0,0,10,0" />
                            <ui:TextBlock FontTypography="BodyStrong" Text="Models" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource FactValue}" Text="{Binding ModelsFolder}" TextTrimming="CharacterEllipsis" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding DiskFree}" Margin="0,2,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Manage models" Margin="0,0,8,0" Command="{Binding OpenModelsCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Cube24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Content="Open folder" Appearance="Transparent" Command="{Binding OpenModelsFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
